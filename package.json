{
  "name": "ai-code-manager",
  "productName": "AI Code Manager",
  "version": "0.3.0",
  "private": true,
  "description": "类 Claude Code 的 Windows 桌面 AI 编程助手（Electron + TypeScript）",
  "author": "ai-code-manager",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/backend/main.js",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p .",
    "start": "npm run build && electron .",
    "web": "node scripts/web-dev.ts",
    "dist": "npm run build && electron-builder --win nsis portable --x64"
  },
  "workspaces": [
    "src/frontend",
    "src/backend"
  ],
  "build": {
    "appId": "dev.aicodemanager.app",
    "productName": "AI Code Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/src/**/*",
      "dist/contracts/**/*",
      "src/frontend/index.html",
      "src/frontend/styles.css",
      "package.json",
      "!dist/tests/**/*",
      "!dist/src/frontend/web/**/*",
      "!dist/scripts/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}-x64.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-x64.${ext}"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
